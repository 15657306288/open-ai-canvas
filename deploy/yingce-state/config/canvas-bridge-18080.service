[Unit]
Description=Canvas 18080 bridge (docker gateway -> web container 5173) for Caddy
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:18080,bind=172.23.0.1,fork,reuseaddr TCP:127.0.0.1:5173
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
