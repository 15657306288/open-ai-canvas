# ============================================================
# 影策 L3 服务器集中配置模板（Mac 当服务器 · launchd 托管）
# 复制到 ~/.infinite-canvas/l3.env 后按需修改（wrapper 与启动脚本均读取它）
# 对外部署请务必把四个 token 都改为相互独立的强随机值。
# ============================================================

# 画布 agent 代码目录（本机 clone 路径）
CANVAS_L3_DIR=/Users/<USER>/open-ai-canvas/canvas-agent

# 端口
CANVAS_L3_RUNTIME_PORT=17371
CANVAS_L3_BROKER_PORT=17800
CANVAS_L3_GATEWAY_PORT=17801

# Runtime bridge 凭据（仅本机 Runtime 与 Broker 使用；对外部署请改强随机值）
CANVAS_L3_BRIDGE_TOKEN=change-me-bridge-token
# Broker 注册/换证凭据（仅 bridge 启动注册使用；必须与 Agent token 分离）
CANVAS_L3_BROKER_REGISTRATION_TOKEN=change-me-registration-token
# Gateway 调 Broker 的 Agent Bearer（不能复用 bridge 或 gateway token）
CANVAS_L3_BROKER_AGENT_TOKEN=change-me-agent-token
# 外部 agent 接入网关的 Bearer（对外部署请改强随机值）
CANVAS_L3_GATEWAY_TOKEN=change-me-gateway-token

# —— P1/P2/P3 商业化（可选，默认即可用）——
# 客户 Key 库文件（默认 ~/.infinite-canvas/gateway-keys.json，0600）
# CANVAS_GATEWAY_KEYS_FILE=/Users/<USER>/.infinite-canvas/gateway-keys.json
# 用量明细 JSONL（默认 ~/.infinite-canvas/gateway-usage.jsonl，P2 账单数据源）
# CANVAS_GATEWAY_USAGE_LOG=/Users/<USER>/.infinite-canvas/gateway-usage.jsonl
# 定价表（默认 ~/.infinite-canvas/gateway-pricing.json，三级命中：精确/通配 canvas_*/默认）
# CANVAS_GATEWAY_PRICING_FILE=/Users/<USER>/.infinite-canvas/gateway-pricing.json
# P3 OAuth2 access_token 有效期秒（默认 3600）
# CANVAS_GATEWAY_TOKEN_TTL=3600
#
# —— 标准 MCP OAuth2.1（授权码 + PKCE，供 codex mcp login）——
# 对外公网基址，用于拼 discovery metadata 的绝对 URL（必须与隧道正式域名一致）
# CANVAS_GATEWAY_PUBLIC_BASE_URL=https://yingce.cc.cd
# 动态注册客户端 + refresh_token 持久化文件（默认 ~/.infinite-canvas/oauth-store.json，0600）
# CANVAS_OAUTH_STORE_FILE=/Users/<USER>/.infinite-canvas/oauth-store.json
# 授权码 access/refresh 有效期毫秒（默认 access 1h / refresh 30d）
# CANVAS_OAUTH_ACCESS_TTL=3600000
# CANVAS_OAUTH_REFRESH_TTL=2592000000
#
# —— 账户来源（商业化切换：本地 KeyStore ↔ 网站后端钱包）——
# local（默认，内测）：身份/余额/配额走本地 gateway-keys.json
# remote（商业化）：经内部 HTTP 调网站后端账户/钱包服务（客户网站注册充值）
# CANVAS_ACCOUNT_PROVIDER=local
# remote 必填：网站后端内部接口基址 + 网关↔后端内部服务令牌（对外不可见）
# CANVAS_ACCOUNT_BASE_URL=https://yingce.cc.cd/api/internal
# CANVAS_ACCOUNT_ADMIN_TOKEN=请用随机长字符串并与后端保持一致

# bridge 唯一标识（本机 hostname + runtime 端口）
CANVAS_L3_BRIDGE_ID=mac-17371

# 日志目录
CANVAS_L3_LOG_DIR=/Users/<USER>/.infinite-canvas

# Runtime masterToken（留空则自动从 ~/.infinite-canvas/canvas-agent.json 读取）
CANVAS_L3_RUNTIME_TOKEN=
